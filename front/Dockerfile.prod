# Stage 1: Сборка
FROM node:19-bullseye AS builder
WORKDIR /app

# Устанавливаем netcat для проверки доступности goapp1
RUN apt-get update && apt-get install -y netcat-openbsd && rm -rf /var/lib/apt/lists/*

COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY . .

ARG API_URL
ENV API_URL=${API_URL}

# 🔥 ЖДЕМ goapp1 ПЕРЕД БИЛДОМ!
RUN echo "⏳ Ожидаем goapp1:8100..." && \
    while ! nc -z goapp1 8100; do \
        echo "⏳ goapp1 еще не готов, ждем 2 секунды..."; \
        sleep 2; \
    done && \
    echo "✅ goapp1 готов! Начинаем сборку..." && \
    yarn build

# Stage 2: Продакшн
FROM node:19-bullseye-slim AS runner
WORKDIR /app

RUN apt-get update && \
    apt-get install -y nginx supervisor procps curl && \
    rm -rf /var/lib/apt/lists/*

ENV NODE_ENV production

ARG API_URL
ENV API_URL=${API_URL}

COPY --from=builder /app/public ./public
COPY --from=builder /app/.next/standalone ./
COPY --from=builder /app/.next/static ./.next/static

COPY nginx/nginx.conf /etc/nginx/sites-enabled/default
COPY supervisor/supervisord.conf /etc/supervisor/conf.d/supervisord.conf

RUN if [ -d "/app/public/images" ]; then \
        ln -sf /app/public/images /app/public/fonts; \
    fi

EXPOSE 80

HEALTHCHECK --interval=60s --timeout=3s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:80/ || exit 1

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]